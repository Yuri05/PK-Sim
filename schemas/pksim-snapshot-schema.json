        "Parameters": { "type": "array", "items": { "$ref": "#/definitions/Parameter" } },
        "Seed": { "type": "integer" },
        "DistributionType": { "type": "string" }
      }
    },
    "Population": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Name": { "type": "string" },
        "Description": { "type": "string" },
        "Seed": { "type": ["integer", "null"] },
        "Settings": { "$ref": "#/definitions/PopulationSettings" },
        "AdvancedParameters": { "type": "array", "items": { "$ref": "#/definitions/AdvancedParameter" } }
      }
    },
    "Formulation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Name": { "type": "string" },
        "Description": { "type": "string" },
        "FormulationType": { "type": "string" },
        "Parameters": { "type": "array", "items": { "$ref": "#/definitions/Parameter" } }
      }
    },
    "SchemaItem": {
