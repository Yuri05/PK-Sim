{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/Open-Systems-Pharmacology/PK-Sim/develop/schemas/pksim-snapshot-schema.json",
  "title": "PK-Sim Snapshot (Project)",
  "description": "JSON Schema describing the structure of a PK-Sim snapshot file as produced by PKSim.Core.Snapshots and serialized by PKSim.Infrastructure.Serialization.Json. The root of a snapshot file is a Project. Serialization notes: null values are omitted (NullValueHandling.Ignore), enums are written as strings (StringEnumConverter), System.Drawing.Color values are written as hex strings (e.g. '#RRGGBB' or '#AARRGGBB'), and IEnumerable snapshot wrappers (CalculationMethodCache, OutputSchema, OutputSelections) are written as plain JSON arrays.",
  "$ref": "#/definitions/Project",
  "definitions": {
    "Color": {
      "type": "string",
      "description": "System.Drawing.Color serialized as hex string, e.g. '#RRGGBB' or '#AARRGGBB'.",
      "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
    },
    "FloatValue": {
      "description": "A floating point value. Non-finite IEEE values are serialized by JSON.NET as strings ('NaN', 'Infinity', '-Infinity').",
      "oneOf": [
        { "type": "number" },
        { "type": "string", "enum": ["NaN", "Infinity", "-Infinity"] }
      ]
    },
    "ValueOrigin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Id": { "type": "integer" },
        "Source": { "type": "string" },
        "Method": { "type": "string" },
        "Description": { "type": "string" }
      }
    },
    "Parameter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Name": { "type": "string" },
        "Description": { "type": "string" },
        "Value": { "type": ["number", "null"] },
        "Unit": { "type": "string" },
        "ValueOrigin": { "$ref": "#/definitions/ValueOrigin" },
        "TableFormula": { "$ref": "#/definitions/TableFormula" }
      }
    },
    "LocalizedParameter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Name": { "type": "string" },
        "Description": { "type": "string" },
        "Value": { "type": ["number", "null"] },
        "Unit": { "type": "string" },
        "ValueOrigin": { "$ref": "#/definitions/ValueOrigin" },
        "TableFormula": { "$ref": "#/definitions/TableFormula" },
        "Path": { "type": "string" }
      }
    },
    "Point": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "X": { "type": "number" },
        "Y": { "type": "number" },
        "RestartSolver": { "type": "boolean" }
      }
    },
    "DistributionMetaData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Mean": { "type": "number" },
        "Deviation": { "type": "number" },
        "Distribution": { "type": "string" }
      }
    },
    "TableFormula": {
      "type": "object",
      "description": "TableFormula and its subclass DistributedTableFormula (Percentile and DistributionMetaData only appear for distributed table formulas).",
      "additionalProperties": false,
      "properties": {
        "Name": { "type": "string" },
        "Description": { "type": "string" },
        "XName": { "type": "string" },
        "XDimension": { "type": "string" },
        "XUnit": { "type": "string" },
        "YName": { "type": "string" },
        "YDimension": { "type": "string" },
        "YUnit": { "type": "string" },
        "UseDerivedValues": { "type": "boolean" },
        "Points": { "type": "array", "items": { "$ref": "#/definitions/Point" } },
        "Percentile": { "type": "number" },
        "DistributionMetaData": { "type": "array", "items": { "$ref": "#/definitions/DistributionMetaData" } }
      }
    },
    "Alternative": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Name": { "type": "string" },
        "Description": { "type": "string" },
        "IsDefault": { "type": ["boolean", "null"] },
        "Species": { "type": "string" },
        "Parameters": { "type": "array", "items": { "$ref": "#/definitions/Parameter" } }
      }
    },
    "PkaType": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Type": { "type": "string" },
        "Pka": { "type": "number" },
        "ValueOrigin": { "$ref": "#/definitions/ValueOrigin" }
      }
    },
    "CompoundProcess": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Name": { "type": "string" },
        "Description": { "type": "string" },
        "InternalName": { "type": "string" },
        "DataSource": { "type": "string" },
        "Species": { "type": "string" },
        "Molecule": { "type": "string" },
        "Metabolite": { "type": "string" },
        "Parameters": { "type": "array", "items": { "$ref": "#/definitions/Parameter" } }
      }
    },
    "CalculationMethodCache": {
      "type": "array",
      "description": "CalculationMethodCache is serialized as a plain array of calculation method names.",
      "items": { "type": "string" }
    },
    "Compound": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Name": { "type": "string" },
        "Description": { "type": "string" },
        "IsSmallMolecule": { "type": ["boolean", "null"] },
        "PlasmaProteinBindingPartner": { "type": ["string", "null"] },
        "Lipophilicity": { "type": "array", "items": { "$ref": "#/definitions/Alternative" } },
        "FractionUnbound": { "type": "array", "items": { "$ref": "#/definitions/Alternative" } },
        "Solubility": { "type": "array", "items": { "$ref": "#/definitions/Alternative" } },
        "IntestinalPermeability": { "type": "array", "items": { "$ref": "#/definitions/Alternative" } },
        "Permeability": { "type": "array", "items": { "$ref": "#/definitions/Alternative" } },
        "PkaTypes": { "type": "array", "items": { "$ref": "#/definitions/PkaType" } },
        "Processes": { "type": "array", "items": { "$ref": "#/definitions/CompoundProcess" } },
        "CalculationMethods": { "$ref": "#/definitions/CalculationMethodCache" },
        "Parameters": { "type": "array", "items": { "$ref": "#/definitions/Parameter" } }
      }
    },
    "ExpressionContainer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Name": { "type": "string" },
        "Description": { "type": "string" },
        "Value": { "type": ["number", "null"] },
        "Unit": { "type": "string" },
        "ValueOrigin": { "$ref": "#/definitions/ValueOrigin" },
        "TableFormula": { "$ref": "#/definitions/TableFormula" },
        "MembraneLocation": { "type": ["string", "null"] },
        "TransportDirection": { "type": ["string", "null"] },
        "CompartmentName": { "type": "string" }
      }
    },
    "Ontogeny": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Name": { "type": "string" },
        "Description": { "type": "string" },
        "Table": { "$ref": "#/definitions/TableFormula" }
      }
    },
    "DiseaseState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Name": { "type": "string" },
        "Parameters": { "type": "array", "items": { "$ref": "#/definitions/Parameter" } }
      }
    },
    "ExpressionProfile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Name": { "type": "string" },
        "Description": { "type": "string" },
        "Type": { "type": "string" },
        "Species": { "type": "string" },
        "Molecule": { "type": "string" },
        "Category": { "type": "string" },
        "Parameters": { "type": "array", "items": { "$ref": "#/definitions/LocalizedParameter" } },
        "MembraneLocation": { "type": ["string", "null"] },
        "TissueLocation": { "type": ["string", "null"] },
        "IntracellularVascularEndoLocation": { "type": ["string", "null"] },
        "Localization": { "type": ["string", "null"] },
        "TransportType": { "type": ["string", "null"] },
        "Expression": { "type": "array", "items": { "$ref": "#/definitions/ExpressionContainer" } },
        "Ontogeny": { "$ref": "#/definitions/Ontogeny" },
        "Disease": { "$ref": "#/definitions/DiseaseState" }
      }
    },
    "OriginData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "CalculationMethods": { "$ref": "#/definitions/CalculationMethodCache" },
        "Species": { "type": "string" },
        "Population": { "type": "string" },
        "Gender": { "type": "string" },
        "Age": { "$ref": "#/definitions/Parameter" },
        "GestationalAge": { "$ref": "#/definitions/Parameter" },
        "Weight": { "$ref": "#/definitions/Parameter" },
        "Height": { "$ref": "#/definitions/Parameter" },
        "ValueOrigin": { "$ref": "#/definitions/ValueOrigin" },
        "Disease": { "$ref": "#/definitions/DiseaseState" },
        "DiseaseState": { "type": "string" },
        "DiseaseStateParameters": { "type": "array", "items": { "$ref": "#/definitions/Parameter" } }
      }
    },
    "Individual": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Name": { "type": "string" },
        "Description": { "type": "string" },
        "Seed": { "type": ["integer", "null"] },
        "OriginData": { "$ref": "#/definitions/OriginData" },
        "Parameters": { "type": "array", "items": { "$ref": "#/definitions/LocalizedParameter" } },
        "Molecules": { "type": "array", "items": { "$ref": "#/definitions/ExpressionProfile" } },
        "ExpressionProfiles": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ParameterRange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Name": { "type": "string" },
        "Min": { "type": ["number", "null"] },
        "Max": { "type": ["number", "null"] },
        "Unit": { "type": "string" }
      }
    },
    "PopulationSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "NumberOfIndividuals": { "type": "integer" },
        "ProportionOfFemales": { "type": ["integer", "null"] },
        "Age": { "$ref": "#/definitions/ParameterRange" },
        "Weight": { "$ref": "#/definitions/ParameterRange" },
        "Height": { "$ref": "#/definitions/ParameterRange" },
        "GestationalAge": { "$ref": "#/definitions/ParameterRange" },
        "BMI": { "$ref": "#/definitions/ParameterRange" },
        "DiseaseStateParameters": { "type": "array", "items": { "$ref": "#/definitions/ParameterRange" } },
        "Individual": { "$ref": "#/definitions/Individual" }
      }
    },
    "AdvancedParameter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Name": { "type": "string" },
