        "FormulationKey": { "type": "string" },
        "TargetOrgan": { "type": "string" },
        "TargetCompartment": { "type": "string" }
      }
    },
    "Schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Name": { "type": "string" },
        "Description": { "type": "string" },
        "Parameters": { "type": "array", "items": { "$ref": "#/definitions/Parameter" } },
        "SchemaItems": { "type": "array", "items": { "$ref": "#/definitions/SchemaItem" } }
      }
    },
    "Protocol": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Name": { "type": "string" },
        "Description": { "type": "string" },
        "Parameters": { "type": "array", "items": { "$ref": "#/definitions/Parameter" } },
        "ApplicationType": { "type": "string" },
        "DosingInterval": { "type": "string" },
        "TargetOrgan": { "type": "string" },
        "TargetCompartment": { "type": "string" },
        "Schemas": { "type": "array", "items": { "$ref": "#/definitions/Schema" } },
        "TimeUnit": { "type": "string" }
      }
    },
    "Event": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Name": { "type": "string" },
        "Description": { "type": "string" },
        "Parameters": { "type": "array", "items": { "$ref": "#/definitions/Parameter" } },
        "Template": { "type": "string" }
      }
    },
    "DescriptorCondition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Tag": { "type": "string" },
        "Type": { "type": "string" }
      }
    },
    "FormulaUsablePath": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Alias": { "type": "string" },
        "Dimension": { "type": "string" },
        "Path": { "type": "string" }
      }
    },
    "ExplicitFormula": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Name": { "type": "string" },
        "Description": { "type": "string" },
        "Formula": { "type": "string" },
